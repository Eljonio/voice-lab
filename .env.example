# Copy to .env and fill in what you use (`set -a; . ./.env; set +a`). Never commit the filled file.
# Secrets are read from environment variables or from files whose PATHS are given here — keep those files outside the repo, mode 600.

# ---- paths -----------------------------------------------------------------------------------
# local dataset root (raw/, clean/, work/, testmix/)
VOICE_DS=
# working root on the GPU/CPU server: weights/, corpora/, mixes, runs/, code/VoxCPM
VOICE_HOME=
# VoxCPM2 weights folder (default: $VOICE_HOME/weights/VoxCPM2 or voxcpm2/weights/VoxCPM2)
VOXCPM2_WEIGHTS=
# short open-corpus clips for scripts/make_testmix.py
TESTMIX_SPEECH=

# ---- evaluation ------------------------------------------------------------------------------
# GigaAM-Multilingual revision (default: pinned commit in scripts/gigaam_eval.py)
GIGAAM_REV=
# regex of brand names excluded from CER (empty = nothing excluded)
EVAL_SKIP_RE=

# ---- TTS server (serve/tts_server.py) ---------------------------------------------------------
TTS_HOME=
TTS_HOST=127.0.0.1
TTS_PORT=8000
# file with the bearer token clients must send
TTS_TOKEN_FILE=
TTS_WEIGHTS=
# LoRA snapshot folder (lora_weights.safetensors) or "none" for base / merged weights
TTS_CKPT=none
TTS_VOICES_DIR=
# 1 = no model, synthetic audio (tests)
TTS_MOCK=0

# ---- call stand (serve/call_server.py) ---------------------------------------------------------
CALL_HOME=
CALL_TOKEN_FILE=
CALL_GUEST_SECRET_FILE=
CALL_TLS_CERT=
CALL_TLS_KEY=
TTS_URL=http://127.0.0.1:8000
CALL_TTS_URL_RU=
CALL_PUBLIC_BASE=
# bot | llm | script | echo
CALL_BRAIN=script
# external dialogue backend for CALL_BRAIN=bot (NDJSON protocol, see the call_server.py docstring)
BOT_TURN_URL=
BOT_VOICE_KEY=
BOT_VOICE_KEY_FILE=
BOT_TENANT=demo
# OpenAI-compatible endpoint for CALL_BRAIN=llm
CALL_LLM_URL=
CALL_LLM_MODEL=
CALL_LLM_KEY_FILE=
# optional test guest for lab calls (digits only)
CALL_LAB_GUEST_PHONE=
CALL_LAB_GUEST_NAME=

# ---- local low-VRAM synthesis (serve/local_tts.py) ---------------------------------------------
LOCAL_BASE=
LOCAL_LORA=
LOCAL_OUT=
